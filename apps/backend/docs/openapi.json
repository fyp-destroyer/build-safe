{
  "openapi": "3.1.0",
  "info": {
    "title": "BuildSafe AI API",
    "version": "0.0.1"
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register",
        "operationId": "register_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "List Jobs",
        "operationId": "list_jobs_jobs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/JobOut"
                  },
                  "type": "array",
                  "title": "Response List Jobs Jobs Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Create Job",
        "operationId": "create_job_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/jobs/{job_id}/followup": {
      "patch": {
        "tags": [
          "jobs"
        ],
        "summary": "Submit Followup",
        "operationId": "submit_followup_jobs__job_id__followup_patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobFollowupRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}/assess": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Assess Job",
        "operationId": "assess_job_jobs__job_id__assess_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/assessments/{job_id}": {
      "get": {
        "tags": [
          "assessments"
        ],
        "summary": "Get Assessment",
        "operationId": "get_assessment_assessments__job_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RiskAssessmentOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/recommendations/{job_id}": {
      "get": {
        "tags": [
          "recommendations"
        ],
        "summary": "Get Recommendations",
        "operationId": "get_recommendations_recommendations__job_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationsOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness check. Must never touch the DB or AI layer.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness",
        "description": "Readiness check: is this instance able to actually assess a job?\n\nSeparate from /health on purpose. /health answers \"is the process\nalive\" and must stay dependency-free; this answers \"is the AI layer\nusable\", which needs the model loaded. A deployment can be live but not\nready, and that distinction is the whole point of splitting them.\n\nReports degraded rather than failing: intake still works without the\nclassifier, only assessment does not.",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Readiness Health Ready Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssessJobResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "risk_level": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Level"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status"
        ],
        "title": "AssessJobResponse",
        "description": "POST /jobs/{id}/assess response \u2014 thin wrapper; full detail lives at\nGET /assessments/{job_id}."
      },
      "FollowupPrompt": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "question": {
            "type": "string",
            "title": "Question"
          }
        },
        "type": "object",
        "required": [
          "field",
          "question"
        ],
        "title": "FollowupPrompt",
        "description": "A single still-missing safety-critical follow-up, with Gemini-phrased\nquestion wording for an already-hardcoded field (rules.md \u00a74 - the LLM\nonly supplies wording, never which field or whether it's required)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobCreateRequest": {
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Description"
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "electrical",
                  "plumbing",
                  "carpentry",
                  "masonry",
                  "painting",
                  "tiling",
                  "hvac",
                  "roofing",
                  "general"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "skill_level": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Skill Level"
          },
          "urgency": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Urgency"
          }
        },
        "type": "object",
        "required": [
          "description",
          "skill_level",
          "urgency"
        ],
        "title": "JobCreateRequest",
        "description": "POST /jobs body.\n\n`category` is optional: when omitted, the frontend's conversational\nintake sends only free-text `description`, and the backend infers the\ncategory via Gemini tagging (a fixed, closed 9-value classification \u2014\nrules.md \u00a74, see ai/rule_engine/llm_assist.tag_category). When provided\nexplicitly, it's used as-is (still validated against the fixed Literal)."
      },
      "JobFollowupRequest": {
        "properties": {
          "answers": {
            "additionalProperties": true,
            "type": "object",
            "title": "Answers"
          }
        },
        "type": "object",
        "title": "JobFollowupRequest",
        "description": "PATCH /jobs/{id}/followup body \u2014 free-form answers keyed by field\nname. Real per-category question schema is a Phase 5 concern; until\nthen this is intentionally open-ended (mirrors Job.followup_answers)."
      },
      "JobOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "skill_level": {
            "type": "string",
            "title": "Skill Level"
          },
          "urgency": {
            "type": "string",
            "title": "Urgency"
          },
          "followup_answers": {
            "additionalProperties": true,
            "type": "object",
            "title": "Followup Answers"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "next_followup": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FollowupPrompt"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "description",
          "category",
          "skill_level",
          "urgency",
          "followup_answers",
          "status",
          "created_at"
        ],
        "title": "JobOut",
        "description": "Job representation returned to the client.\n\n`next_followup` is computed at request time (not persisted on the Job\nmodel) \u2014 see services/job_service.py's `_next_followup_prompt`. It is\n`None` once there's nothing safety-critical left to ask."
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 255,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "description": "POST /auth/login body."
      },
      "RecommendationsOut": {
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid",
            "title": "Job Id"
          },
          "risk_level": {
            "type": "integer",
            "title": "Risk Level"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/RecommendedItem"
            },
            "type": "array",
            "title": "Items"
          },
          "is_placeholder": {
            "type": "boolean",
            "title": "Is Placeholder",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "risk_level",
          "items"
        ],
        "title": "RecommendationsOut",
        "description": "GET /recommendations/{job_id} response."
      },
      "RecommendedItem": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "required": {
            "type": "boolean",
            "title": "Required"
          },
          "note": {
            "type": "string",
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "name",
          "category",
          "required",
          "note"
        ],
        "title": "RecommendedItem",
        "description": "A single placeholder tool/material/PPE recommendation."
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 255,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password",
          "name"
        ],
        "title": "RegisterRequest",
        "description": "POST /auth/register body."
      },
      "RiskAssessmentOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "job_id": {
            "type": "string",
            "format": "uuid",
            "title": "Job Id"
          },
          "risk_level": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Risk Level"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "hazard_tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Hazard Tags"
          },
          "triggered_rules": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Triggered Rules"
          },
          "cost": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost"
          },
          "time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time"
          },
          "difficulty": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Difficulty"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "job_id",
          "risk_level",
          "confidence",
          "explanation",
          "hazard_tags",
          "triggered_rules",
          "cost",
          "time",
          "difficulty",
          "status",
          "created_at"
        ],
        "title": "RiskAssessmentOut",
        "description": "GET /assessments/{job_id} response."
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "user"
        ],
        "title": "TokenResponse",
        "description": "POST /auth/register and /auth/login response."
      },
      "UserOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "created_at"
        ],
        "title": "UserOut",
        "description": "Public user representation."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}