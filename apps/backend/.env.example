DATABASE_URL=postgresql+asyncpg://buildsafe:buildsafe@localhost:5434/buildsafe
JWT_SECRET=changeme
ENV=development

# --- LLM provider ------------------------------------------------------
# Which provider ai/llm/client.py calls: gemini | groq | auto (default).
# "auto" uses whichever key is set below, preferring Gemini when both are —
# so adding a Groq key never silently switches an existing setup. Set this
# to groq explicitly to make the switch.
#
# The LLM only tags categories/hazards against fixed closed sets and phrases
# follow-up questions; it can never produce a risk level (rules.md §4), and
# every reply is validated against a Pydantic schema before use. So the
# provider choice affects wording/tagging quality, never a safety decision —
# if a model answers badly or not at all, the code falls back to hardcoded
# defaults.
LLM_PROVIDER=auto

# Obtain from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=...
# Obtain from the Groq console: https://console.groq.com/keys
GROQ_API_KEY=

# Model overrides — a model retirement should be a config change, not a code
# change (gemini-2.5-flash already caught us out this way).
GEMINI_MODEL=gemini-3.1-flash-lite
# llama-3.3-70b-versatile is a safe, long-lived default and is plenty for
# these small classification calls, but it does NOT support Groq's
# json_schema structured outputs — the client detects the 400 and falls back
# to json_object mode plus schema validation, which is equally safe. For
# server-side schema enforcement, use a model that supports it (e.g.
# openai/gpt-oss-20b or moonshotai/kimi-k2-instruct).
# Run `python scripts/check_llm.py` to see which mode your model actually
# lands in, and `--list` to print the models your key can use.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: overrides the Postgres URL used by the pytest suite (tests/conftest.py).
# Defaults to a disposable Postgres instance on port 5433, kept separate from the
# docker-compose dev DB on 5432 so tests never touch dev data, e.g.:
#   docker run -d --name buildsafe-postgres-test -e POSTGRES_USER=buildsafe \
#     -e POSTGRES_PASSWORD=buildsafe -e POSTGRES_DB=buildsafe_test -p 5433:5432 \
#     pgvector/pgvector:pg16
TEST_DATABASE_URL=postgresql+asyncpg://buildsafe:buildsafe@127.0.0.1:5433/buildsafe_test

# --- Risk pipeline ---------------------------------------------------------
# Whether the ML classifier participates in final_risk = max(ml, rules).
# true  = the documented pipeline (architecture.md §2, srs.md §8.1 NFR-03).
# false = rules only. The classifier still runs and is still logged to
#         ai_logs, but does not affect the result.
# Removing a term from a max() can only LOWER it: with this false, a task
# matching no keyword and receiving no LLM hazard tag returns level 1 with
# nothing to catch it. See core/config.py for why that was accepted in dev.
RISK_USE_ML_CLASSIFIER=true

# Browser origins allowed to call the API (comma-separated, no wildcard —
# credentials are involved). Must include whatever port the frontend runs on;
# a mismatch fails at the CORS preflight, which does not look like a CORS bug
# from the browser console.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
